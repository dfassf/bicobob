{
  "productName": "비코밥",
  "version": "1.0.0",
  "identifier": "com.biocom.biconote-tray",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "비코밥",
        "width": 300,
        "height": 360,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["menu"],
          "radius": 12.0
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": false,
      "tooltip": "비코밥 - 오늘의 점심"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "2026 Biocom AI혁신팀",
    "shortDescription": "메뉴바 점심 메뉴",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
